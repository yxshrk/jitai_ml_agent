# Run evidence policy: journals, summaries, node code, metrics and probe logs of
# EVERY run are tracked (judges must be able to audit all disclosed runs).
# Heavy artifacts (workspaces, predictions, arrays) stay untracked.
logs/run_*/workspace/
logs/run_*/**/predictions.csv
logs/run_*/**/*.npy
logs/run_*/**/*.npz
logs/run_*/**/scores.csv
.venv/
.uv-cache/
__pycache__/
.pytest_cache/
*.pyc
.env
data/real/
# … but official/deliverable runs ARE tracked:
!logs/bonus_1k_*/metrics.json
*.egg-info
logs/spend.*
data/real_ws/
data/real_ws_27k/
data/random_probe/
data/real_ws_1k/
data/random_probe/
logs/*/predictions.csv
logs/k1_*/
logs/bonus_1k_*/predictions.csv
logs/seedext/
evidence/test_submission_1k.csv
MACHINES.local.md
evidence/test_submission_1k_faithful.csv
evidence/test_submission_1k_omega.csv
