+def expert_rank_blend(users, champion, expert):
+    champion_rank = normalized_ranks(users, champion)
+    return normalized_ranks(users, 0.9 * champion_rank + 0.1 * expert, champion_rank)
+
+def attention_keys(rows, ui, ti, di, xi):
+    users = np.asarray([x[ui] for x in rows])
+    times = np.asarray([int(float(x[xi])) for x in rows], dtype=np.int64)
+    demand = np.asarray([float(x[di]) for x in rows], dtype=np.float64)
+    demand[~np.isfinite(demand)] = 0.0
+    demand = np.minimum(np.maximum(demand, 0.0), 18000.0)
+    order = np.lexsort((np.arange(len(rows)), times, users))
+    sorted_users = users[order]
+    starts = np.r_[0, np.flatnonzero(sorted_users[1:] != sorted_users[:-1]) + 1]
+    ends = np.r_[starts[1:], len(order)]
+    load = np.zeros(len(rows), dtype=np.float64)
+    for lo, hi in zip(starts, ends):
+        left, p, running = lo, lo, 0.0
+        while p < hi:
+            now = times[order[p]]
+            while left < p and times[order[left]] < now - 600_000:
+                running -= demand[order[left]]
+                left += 1
+            q = p + 1
+            while q < hi and times[order[q]] == now:
+                q += 1
+            load[order[p:q]] = running
+            running += demand[order[p:q]].sum()
+            p = q
+    threshold_bin = np.where(demand <= 0.0, 0, 1 + np.searchsorted([6000.0, 12000.0], demand))
+    load_bin = np.searchsorted([1.0, 18000.0, 54000.0, 180000.0], load)
+    return [(x[ti], int(threshold_bin[i]), int(load_bin[i])) for i, x in enumerate(rows)]
+
+def fit_attention_expert(keys, labels):
+    cells, baselines = {}, {}
+    global_rate = float(np.mean(labels))
+    for key, y in zip(keys, labels):
+        n, p = cells.get(key, (0, 0.0))
+        cells[key] = (n + 1, p + float(y))
+        base = key[:2]
+        n, p = baselines.get(base, (0, 0.0))
+        baselines[base] = (n + 1, p + float(y))
+    def score(score_keys):
+        out = np.empty(len(score_keys), dtype=np.float64)
+        for i, key in enumerate(score_keys):
+            bn, bp = baselines.get(key[:2], (0, 0.0))
+            prior = (bp + 20.0 * global_rate) / (bn + 20.0)
+            n, p = cells.get(key, (0, 0.0))
+            out[i] = (p + 50.0 * prior) / (n + 50.0)
+        return out
+    return score
 
