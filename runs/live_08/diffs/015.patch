+def short_threshold_gate(users, durations):
+    users = np.asarray(users)
+    threshold = np.asarray([float(x) for x in durations], dtype=np.float64)
+    threshold[~np.isfinite(threshold)] = 0.0
+    threshold = np.minimum(np.maximum(threshold, 0.0), 18000.0)
+    order = np.argsort(users, kind='stable')
+    sorted_users = users[order]
+    starts = np.r_[0, np.flatnonzero(sorted_users[1:] != sorted_users[:-1]) + 1]
+    ends = np.r_[starts[1:], len(order)]
+    gate = np.zeros(len(users), dtype=bool)
+    for lo, hi in zip(starts, ends):
+        idx = order[lo:hi]
+        gate[idx] = threshold[idx] < np.median(threshold[idx])
+    return gate
 
