+        j = int(jj); current_time = times[j]
+        if last_time is not None and current_time != last_time:
+            for k in pending:
+                label = labels[k]
+                add_history(user_tot, users[k], label)
+                add_history(author_tot, (users[k], authors[k]), label)
+                add_history(tab_tot, (users[k], tabs[k]), label)
+                add_history(dur_tot, (users[k], int(durs[k])), label)
+            pending.clear()
+        last_time = current_time
+        prior = user_tot.get(users[j])
