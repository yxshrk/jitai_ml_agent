+            hist[j, 0] = history_bucket(author_tot.get((users[j], authors[j])), prior)
+            hist[j, 1] = history_bucket(tab_tot.get((users[j], tabs[j])), prior)
+            hist[j, 2] = history_bucket(dur_tot.get((users[j], int(durs[j]))), prior)
+        pending.append(j)
+    for k in pending:
