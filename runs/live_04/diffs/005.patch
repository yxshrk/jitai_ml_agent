 def sigmoid(x):
     return 1.0 / (1.0 + np.exp(-np.clip(x, -30, 30)))
+
+def repeat_history(rows, ui, vi, mi, counts, last):
+    times = np.array([int(x[mi]) for x in rows], dtype=np.int64)
+    order = np.argsort(times, kind='stable')
+    history = [None] * len(rows)
+    p = 0
+    while p < len(order):
+        q = p + 1
+        t = int(times[order[p]])
+        while q < len(order) and times[order[q]] == t:
+            q += 1
+        for k in range(p, q):
+            n = int(order[k]); key = (rows[n][ui], rows[n][vi])
+            count = counts.get(key, 0)
+            gap = 'NEVER' if count == 0 else str(min(20, int(np.log2(1.0 + max(0, t - last[key]) / 1000.0))))
+            history[n] = (str(min(count, 3)), gap)
+        for k in range(p, q):
+            n = int(order[k]); key = (rows[n][ui], rows[n][vi])
+            counts[key] = counts.get(key, 0) + 1
+            last[key] = t
+        p = q
+    return history
 
