+def rank_positions(users, scores, tiebreak=None):
+    users = np.asarray(users); scores = np.asarray(scores)
+    if tiebreak is None:
+        order = np.lexsort((np.arange(len(scores)), -scores, users))
+    else:
+        order = np.lexsort((np.arange(len(scores)), -np.asarray(tiebreak), -scores, users))
+    su = users[order]
+    starts = np.r_[0, np.flatnonzero(su[1:] != su[:-1]) + 1]
+    counts = np.diff(np.r_[starts, len(order)])
+    positions = np.empty(len(order), dtype=np.int32)
+    positions[order] = np.arange(len(order)) - np.repeat(starts, counts)
+    return positions
+
+def top5_gated_fusion(users, branch_scores):
+    linear = 0.6 * branch_scores[0] + 0.4 * branch_scores[1]
+    linear_score = normalized_ranks(users, linear, branch_scores[0])
+    pos0 = rank_positions(users, branch_scores[0])
+    pos1 = rank_positions(users, branch_scores[1])
+    reciprocal = 0.6 / (2.0 + pos0) + 0.4 / (2.0 + pos1)
+    reciprocal_score = normalized_ranks(users, reciprocal, branch_scores[0])
+    affected = (np.minimum(pos0, pos1) < 5) & (pos0 != pos1)
+    hybrid = np.where(affected, reciprocal_score, linear_score)
+    return normalized_ranks(users, hybrid, branch_scores[0])
 
