+def normalized_ranks(users, scores):
+    users = np.asarray(users)
+    scores = np.asarray(scores)
+    order = np.lexsort((np.arange(len(scores)), scores, users))
+    sorted_users = users[order]
+    starts = np.flatnonzero(np.r_[True, sorted_users[1:] != sorted_users[:-1]])
+    counts = np.diff(np.r_[starts, len(scores)])
+    positions = np.arange(len(scores)) - np.repeat(starts, counts)
+    ranks = np.empty(len(scores), dtype=np.float64)
+    ranks[order] = positions / np.repeat(np.maximum(counts - 1, 1), counts)
+    return ranks
+
+def rank_blend(users, champion_scores, sibling_scores):
+    champion_ranks = normalized_ranks(users, champion_scores)
+    sibling_ranks = normalized_ranks(users, sibling_scores)
+    return 0.5 * (champion_ranks + sibling_ranks) + 1e-6 * champion_ranks
 
