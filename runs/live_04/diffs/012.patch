+class StandardFM(FM):
+    def __init__(self, dim, k=16, lr=0.001, l2=1e-6, seed=0):
+        super().__init__(dim, k=k, lr=lr, l2=l2, seed=seed)
+        rng = np.random.default_rng(seed)
+        self.V = rng.normal(0, 0.01, (dim, k)).astype(np.float32)
+        self.mV = np.zeros_like(self.V); self.vV = np.zeros_like(self.V)
+
+    def logits(self, X):
+        E = self.V[X]
+        S = E.sum(1)
+        inter = 0.5 * ((S * S) - (E * E).sum(1)).sum(1)
+        return self.b + self.W[X].sum(1) + inter, E, S
+
+    def step(self, Xp, Xn):
+        B = len(Xp)
+        zp, Ep, Sp = self.logits(Xp); zn, En, Sn = self.logits(Xn)
+        d = zp - zn
+        g = ((sigmoid(d) - 1.0) / B).astype(np.float32)
+        gV = np.zeros_like(self.V); gW = np.zeros_like(self.W)
+        for X, h, E, S in ((Xp, g, Ep, Sp), (Xn, -g, En, Sn)):
+            np.add.at(gW, X, h[:, None])
+            for i in range(len(FIELDS)):
+                np.add.at(gV, X[:, i], h[:, None] * (S - E[:, i]))
+        gV += self.l2 * self.V; gW += self.l2 * self.W
+        self.t += 1
+        b1, b2, eps = 0.9, 0.999, 1e-8
+        for P, G, M, Vv in ((self.V, gV, self.mV, self.vV), (self.W, gW, self.mW, self.vW)):
+            M *= b1; M += (1 - b1) * G
+            Vv *= b2; Vv += (1 - b2) * (G * G)
+            P -= self.lr * (M / (1 - b1 ** self.t)) / (np.sqrt(Vv / (1 - b2 ** self.t)) + eps)
+        return float(-np.mean(np.log(sigmoid(d) + 1e-9)))
