+
+def reorder_slots(users, base_scores, specialist_scores, selected):
+    users = np.asarray(users); base_scores = np.asarray(base_scores)
+    selected = np.asarray(selected, dtype=np.int64)
+    result = base_scores.copy()
+    if len(selected) == 0:
+        return result
+    slot_order = selected[np.lexsort((selected, result[selected], users[selected]))]
+    specialist_order = selected[np.lexsort((selected, np.asarray(specialist_scores), users[selected]))]
+    result[specialist_order] = result[slot_order]
+    return result
 
