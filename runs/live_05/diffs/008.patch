 def sigmoid(x):
     return 1.0 / (1.0 + np.exp(-np.clip(x, -30, 30)))
+
+def demote_duration_zero(scores, user_groups, duration_zero):
+    scores = np.asarray(scores, dtype=np.float64).copy()
+    lo = np.full(int(user_groups.max()) + 1, np.inf)
+    hi = np.full(int(user_groups.max()) + 1, -np.inf)
+    np.minimum.at(lo, user_groups, scores)
+    np.maximum.at(hi, user_groups, scores)
+    scores[duration_zero] -= (hi - lo + 1.0)[user_groups[duration_zero]]
+    return scores
 
