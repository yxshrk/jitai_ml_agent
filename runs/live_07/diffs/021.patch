 def sigmoid(x):
     return 1.0 / (1.0 + np.exp(-np.clip(x, -30, 30)))
+
+def tab_transition_features(rows, ui, tabi, ti, initial=None):
+    users = np.fromiter((int(x[ui]) for x in rows), dtype=np.int64, count=len(rows))
+    times = np.fromiter((int(x[ti]) for x in rows), dtype=np.int64, count=len(rows))
+    tabs = [x[tabi] for x in rows]
+    order = np.lexsort((np.arange(len(rows), dtype=np.int64), times, users))
+    features = np.empty((len(rows), 2), dtype=object)
+    state = {} if initial is None else initial.copy()
+    p = 0
+    while p < len(order):
+        oi = int(order[p]); user = int(users[oi])
+        last_tab, streak = state.get(user, (None, 0))
+        while p < len(order) and users[order[p]] == user:
+            now = int(times[order[p]]); q = p + 1
+            while q < len(order) and users[order[q]] == user and times[order[q]] == now:
+                q += 1
+            group_tab = None
+            same_tab = True
+            for oi0 in order[p:q]:
+                oi = int(oi0); current = tabs[oi]
+                previous = 'UNK' if last_tab is None else last_tab
+                current_streak = min(streak + 1, 5) if current == last_tab else 1
+                features[oi] = (previous + '>' + current, current_streak)
+                if group_tab is None:
+                    group_tab = current
+                elif current != group_tab:
+                    same_tab = False
+            if same_tab:
+                streak = min(streak + 1, 5) if group_tab == last_tab else 1
+                last_tab = group_tab
+            else:
+                last_tab, streak = None, 0
+            p = q
+        state[user] = (last_tab, streak)
+    return features, state
 
 def normalized_ranks(users, scores, tiebreak=None):
     users = np.asarray(users); scores = np.asarray(scores)
