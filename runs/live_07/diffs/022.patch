+    def score_step(self, X, g, E=None, S=None):
+        if E is None:
+            _, E, S = self.logits(X)
+        gV = np.zeros_like(self.V); gW = np.zeros_like(self.W)
+        np.add.at(gW, X, g[:, None])
+        np.add.at(gV, X, g[:, None, None] * (S[:, None, :] - E))
+        self.t += 1
+        b1, b2, eps = 0.9, 0.999, 1e-8
+        for P, G, M, Vv in ((self.V, gV, self.mV, self.vV), (self.W, gW, self.mW, self.vW)):
+            M *= b1; M += (1 - b1) * G
+            Vv *= b2; Vv += (1 - b2) * (G * G)
+            P -= self.lr * (M / (1 - b1 ** self.t)) / (np.sqrt(Vv / (1 - b2 ** self.t)) + eps)
+
+    def ndcg_step(self, X, y, weight=0.1, tau=1.0):
+        flat = X.reshape(-1, X.shape[-1])
+        z, E, S = self.logits(flat)
+        z = z.reshape(len(X), X.shape[1])
+        prob = sigmoid((z[:, None, :] - z[:, :, None]) / tau)
+        rank = 1.0 + prob.sum(2) - 0.5
+        logr = np.log1p(rank)
+        discount = np.log(2.0) / logr
+        gate = sigmoid(5.5 - rank)
+        d_discount = -np.log(2.0) / ((1.0 + rank) * logr * logr)
+        d_gate = -gate * (1.0 - gate)
+        npos = np.minimum(y.sum(1).astype(np.int32), 5)
+        ideal = np.r_[0.0, np.cumsum(1.0 / np.log2(np.arange(2, 7)))][npos]
+        approx = (y * discount * gate).sum(1) / ideal
+        h = (-weight / len(X)) * y * (d_discount * gate + discount * d_gate) / ideal[:, None]
+        q = prob * (1.0 - prob) / tau
+        g = (h[:, :, None] * q).sum(1) - h * q.sum(2)
+        self.score_step(flat, g.reshape(-1).astype(np.float32), E, S)
+        return weight * float(np.mean(1.0 - approx))
 
