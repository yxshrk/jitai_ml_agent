+def exposure_context(rows, ui, vi, ti, video_vocab, initial=None):
+    users = np.asarray([x[ui] for x in rows])
+    videos = np.asarray([video_vocab.get(x[vi], len(video_vocab)) for x in rows], dtype=np.int32)
+    times = np.asarray([int(float(x[ti])) for x in rows], dtype=np.int64)
+    order = np.lexsort((np.arange(len(rows)), times, users))
+    sorted_users = users[order]; sorted_times = times[order]
+    starts = np.r_[0, np.flatnonzero((sorted_users[1:] != sorted_users[:-1]) |
+                                     (sorted_times[1:] != sorted_times[:-1])) + 1]
+    ends = np.r_[starts[1:], len(rows)]
+    group_users = sorted_users[starts]
+    same_user = group_users[1:] == group_users[:-1]
+    previous_group = np.full(len(starts), len(video_vocab), dtype=np.int32)
+    continued = np.flatnonzero(same_user) + 1
+    previous_group[continued] = videos[order[ends[continued - 1] - 1]]
+    first = np.r_[True, ~same_user]
+    if initial is not None:
+        previous_group[first] = [initial.get(str(u), len(video_vocab)) for u in group_users[first]]
+    previous = np.empty(len(rows), dtype=np.int32)
+    previous[order] = np.repeat(previous_group, ends - starts)
+    state = {} if initial is None else initial.copy()
+    last_groups = np.r_[np.flatnonzero(~same_user), len(starts) - 1]
+    state.update({str(group_users[g]): int(videos[order[ends[g] - 1]]) for g in last_groups})
+    return videos, previous, state
