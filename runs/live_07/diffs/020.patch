+def monotonic_session_pairs(rows, session):
+    users = np.fromiter((int(x[0]) for x in rows), dtype=np.int64, count=len(rows))
+    times = np.fromiter((int(x[5]) for x in rows), dtype=np.int64, count=len(rows))
+    tabs = np.fromiter((int(x[2]) for x in rows), dtype=np.int16, count=len(rows))
+    durations = np.fromiter((float(x[3]) for x in rows), dtype=np.float64, count=len(rows))
+    order = np.lexsort((np.arange(len(rows), dtype=np.int64), times, users))
+    sorted_users = users[order]; sorted_times = times[order]
+    new_session = np.ones(len(order), dtype=bool)
+    new_session[1:] = ((sorted_users[1:] != sorted_users[:-1]) |
+                       (sorted_times[1:] - sorted_times[:-1] > 1_800_000))
+    session_id = np.cumsum(new_session) - 1
+    target = (durations > 180_000.0) | (tabs == 4)
+    target_pos = np.flatnonzero(target[order])
+    first_target = np.full(int(session_id[-1]) + 1, len(order), dtype=np.int64)
+    np.minimum.at(first_target, session_id[target_pos], target_pos)
+    first_pos = first_target[session_id]
+    have_first = first_pos < len(order)
+    first_pos = np.minimum(first_pos, len(order) - 1)
+    early = order[first_pos]; late = order
+    keep = (have_first & target[late] & (sorted_times > sorted_times[first_pos]) &
+            (session[early, 0] < session[late, 0]) &
+            (session[early, 1] < session[late, 1]))
+    return early[keep].astype(np.int32), late[keep].astype(np.int32)
+
