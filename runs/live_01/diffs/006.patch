+def factorize_values(values):
+    """Deterministically factorize strings in first-occurrence order."""
+    mapping = {}
+    codes = np.empty(len(values), dtype=np.int32)
+    for i, value in enumerate(values):
+        code = mapping.get(value)
+        if code is None:
+            code = len(mapping)
+            mapping[value] = code
+        codes[i] = code
+    return codes
+
