+def daily_buckets(rows, ui, di, mi):
+    n = len(rows)
+    _, users = np.unique(np.asarray([x[ui] for x in rows]), return_inverse=True)
+    dates = np.fromiter((int(x[di]) for x in rows), dtype=np.int64, count=n)
+    times = np.fromiter((int(x[mi]) for x in rows), dtype=np.int64, count=n)
+    order = np.lexsort((np.arange(n, dtype=np.int64), times, dates, users))
+    su, sd, st = users[order], dates[order], times[order]
+    new_day = np.r_[True, (su[1:] != su[:-1]) | (sd[1:] != sd[:-1])]
+    new_time = np.r_[True, new_day[1:] | (st[1:] != st[:-1])]
+    positions = np.arange(n, dtype=np.int64)
+    day_start = np.maximum.accumulate(np.where(new_day, positions, 0))
+    time_start = np.maximum.accumulate(np.where(new_time, positions, 0))
+    prior = time_start - day_start
+    elapsed = st - st[day_start]
+    count_bucket = np.empty(n, dtype=np.int8)
+    elapsed_bucket = np.empty(n, dtype=np.int8)
+    count_bucket[order] = np.searchsorted([1, 3, 10, 30], prior, side='right')
+    elapsed_bucket[order] = np.searchsorted(
+        [600_000, 1_800_000, 3_600_000, 10_800_000, 21_600_000], elapsed, side='right')
+    return count_bucket, elapsed_bucket
+
+def fit_daily_expert(tabs, labels, count_bucket, elapsed_bucket):
+    tab_values, tab_index = np.unique(tabs, return_inverse=True)
+    tab_count = np.bincount(tab_index)
+    tab_pos = np.bincount(tab_index, weights=labels)
+    global_rate = float(np.mean(labels))
+    tab_rate = (tab_pos + 20.0 * global_rate) / (tab_count + 20.0)
+    flat = (tab_index * 5 + count_bucket.astype(np.int64)) * 6 + elapsed_bucket
+    key_count = np.bincount(flat, minlength=len(tab_values) * 30)
+    key_pos = np.bincount(flat, weights=labels, minlength=len(tab_values) * 30)
+    rates = ((key_pos + 20.0 * np.repeat(tab_rate, 30)) /
+             (key_count + 20.0)).reshape(len(tab_values), 5, 6)
+    return {int(v): i for i, v in enumerate(tab_values)}, rates, global_rate
+
+def daily_expert_scores(tabs, count_bucket, elapsed_bucket, fitted):
+    tab_vocab, rates, fallback = fitted
+    tab_index = np.fromiter((tab_vocab.get(int(x), -1) for x in tabs),
+                            dtype=np.int32, count=len(tabs))
+    out = np.full(len(tabs), fallback, dtype=np.float64)
+    known = tab_index >= 0
+    out[known] = rates[tab_index[known], count_bucket[known], elapsed_bucket[known]]
+    return out
+
+def daily_rank_blend(users, champion_ranks, expert_scores):
+    expert = normalized_ranks(users, expert_scores, champion_ranks)
+    return normalized_ranks(users, 0.9 * champion_ranks + 0.1 * expert, champion_ranks)
 
