+def day_number(value):
+    s = str(value).strip()
+    try:
+        n = int(float(s))
+        if 19000101 <= n <= 21001231:
+            return datetime.date(n // 10000, n // 100 % 100, n % 100).toordinal()
+        if n > 10_000_000_000:
+            n //= 1000
+        if n > 1_000_000_000:
+            return datetime.datetime.utcfromtimestamp(n).date().toordinal()
+    except (ValueError, OverflowError, OSError):
+        pass
+    try:
+        return datetime.date.fromisoformat(s[:10].replace('/', '-')).toordinal()
+    except ValueError:
+        return None
 
