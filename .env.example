# Copy to .env and fill in. Required ONLY for launching new agent runs
# (harness.cli) — training, evaluation, ensembles, and all analyses run keyless.
OPENAI_API_KEY=sk-proj-...      # proposer/selector/reflector (gpt-5.6-sol) + fixer (gpt-5.4-mini)
# ANTHROPIC_API_KEY=sk-ant-...  # optional fallback provider (--provider anthropic)
BUDGET_USD=25                   # hard dollar cap enforced by agent/budget.py ledger
